# IMAP and SMTP use this same KAIST ID/password, or DOORAY_EMAIL/password.
KAIST_ID=your-kaist-id
KAIST_PASSWORD=replace-locally
DOORAY_EMAIL=your-kaist-id@kaist.ac.kr
DOORAY_URL=https://kaist.gov-dooray.com

# Verification code source: http or imap. If omitted, KAIST_CODE_URL takes
# precedence, otherwise the IMAP settings below are used.
KAIST_CODE_SOURCE=http
# HTTP: HTTPS endpoint returning {code, id, date, serverTime}; date is RFC3339,
# serverTime is Unix milliseconds. Only fresh messages are accepted.
KAIST_CODE_URL=https://your-code-service.example/
# KAIST_CODE_TOKEN=optional-bearer-token

# Or read the external verification mailbox directly, without a code service.
# Set KAIST_CODE_SOURCE=imap. Requires IMAP with implicit TLS and a host:port.
# KAIST_CODE_IMAP_ADDR=imap.naver.com:993
# KAIST_CODE_IMAP_USERNAME=your-verification-mailbox@naver.com
# KAIST_CODE_IMAP_PASSWORD=replace-locally-with-mailbox-or-app-password
# KAIST_CODE_IMAP_MAILBOX=INBOX
# Defaults to the IMAP username when it is an email address. Set explicitly
# when the login name differs from the destination registered in KAIST SSO.
# KAIST_CODE_IMAP_RECIPIENT=your-verification-mailbox@naver.com

DATA_DIR=data
POLL_INTERVAL=30s
MAX_MESSAGE_BYTES=33554432

# These are implicit TLS listeners (IMAPS and SMTPS).
IMAP_ADDR=127.0.0.1:1993
SMTP_ADDR=127.0.0.1:1465
TLS_CERT=/path/to/fullchain.pem
TLS_KEY=/path/to/privkey.pem

# Development only: numeric loopback addresses required, no public plaintext.
# ALLOW_INSECURE_LOCAL=true

# Docker Compose publishes TLS ports on loopback by default. Set BIND_ADDR to
# the server's LAN IP for remote clients, then forward only these two TCP ports.
# Compose overrides DATA_DIR, listener addresses, TLS paths and plaintext mode.
# BIND_ADDR=192.0.2.10
# IMAP_PORT=1993
# SMTP_PORT=1465
# TLS_CERT_DIR=./certs
# BRIDGE_VERSION=local
