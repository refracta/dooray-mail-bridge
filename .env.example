# IMAP and SMTP use this same KAIST ID/password, or DOORAY_EMAIL/password.
KAIST_ID=your-kaist-id
KAIST_PASSWORD=replace-locally
DOORAY_EMAIL=your-kaist-id@kaist.ac.kr
DOORAY_URL=https://kaist.gov-dooray.com

# HTTPS endpoint returning {code, id, date, serverTime}; date is RFC3339,
# serverTime is Unix milliseconds. Only fresh messages are accepted.
KAIST_CODE_URL=https://your-code-service.example/
# KAIST_CODE_TOKEN=optional-bearer-token

DATA_DIR=data
POLL_INTERVAL=30s
MAX_MESSAGE_BYTES=33554432

# These are implicit TLS listeners (IMAPS and SMTPS).
IMAP_ADDR=127.0.0.1:1993
SMTP_ADDR=127.0.0.1:1465
TLS_CERT=/path/to/fullchain.pem
TLS_KEY=/path/to/privkey.pem

# Development only: numeric loopback addresses required, no public plaintext.
# ALLOW_INSECURE_LOCAL=true
